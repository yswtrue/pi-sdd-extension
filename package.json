{
  "name": "pi-sdd-extension",
  "version": "0.1.9",
  "description": "Spec-driven development workflow extension for pi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yswtrue/pi-sdd-extension.git"
  },
  "homepage": "https://github.com/yswtrue/pi-sdd-extension#readme",
  "bugs": {
    "url": "https://github.com/yswtrue/pi-sdd-extension/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "sdd"
  ],
  "license": "MIT",
  "type": "module",
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "package.json",
    "package-lock.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "ci": "npm run typecheck && npm test && npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "latest",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
